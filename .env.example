# Vinergy — Sample Environment Configuration
# Copy this file to `.env` and fill in your local values.
# NEVER commit `.env` or real API keys to Git.

# --- Backend ---
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_PATH=data/vinergy_dev.db
SESSION_SECRET=change-me-local-dev-only

# --- LLM Provider (Server-side only, used in 1.3.2 spike & Sprint 3) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Frontend (Vite exposes only VITE_* variables to the browser) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# OpNavi Web/JS application with permission to render international maps
VITE_OPNAVI_API_KEY=
# Deployment region of the OpNavi project: sg (default) or de
VITE_OPNAVI_REGION=sg
# Paired Security JS Code for the server-side /_AMapService proxy
OPNAVI_SECURITY_JS_CODE=



# Restrict this browser key by HTTP referrer in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=
# Optional JavaScript map ID; local demos default to DEMO_MAP_ID
VITE_GOOGLE_MAPS_MAP_ID=
